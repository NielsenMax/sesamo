# Copy to .env.local for development, and set the same three values as
# environment variables in Cloudflare Pages. All three are public by design —
# they identify the app, they don't authorise anything on their own. Access is
# granted by the user signing in, and is limited to the drive.file scope.

# OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# API key, restricted to the Google Picker API
VITE_GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Cloud project NUMBER (not the project ID). The Picker needs it to
# attach the per-file grant to this client; without it, opening a spreadsheet
# you already had will fail with 403 on the first read.
VITE_GOOGLE_PROJECT_NUMBER=000000000000
